/* ExplorePage.css */
.explore-page {
    width: 100%;
    min-height: calc(100vh - 60px);
    background-color: var(--background-color);
    padding: 24px 32px;
    box-sizing: border-box;
}

/* Header */
.explore-header {
    margin-bottom: 24px;
}

.header-content {
    margin-bottom: 0;
}

.header-content .eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary-color);
    margin-bottom: 8px;
}

.header-content h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 6px 0;
    line-height: 1.15;
}

.header-content p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
    max-width: 600px;
}

/* Single sticky unit wrapping toolbar + chips */
.explore-sticky {
    position: sticky;
    top: 0;
    z-index: 30;
    padding: 16px 0 16px;
    margin: 0 -32px 20px;
    background: color-mix(in srgb, var(--background-color) 80%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--border-color);
}

.explore-toolbar {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 0 32px;
    margin: 0;
    background: transparent;
    border-bottom: none;
    justify-content: space-between;
}

/* Search Section */
.search-section {
    display: flex;
    gap: 12px;
    align-items: center;
    flex: 1;
    min-width: 280px;
}

/* Segmented sort control */
.sort-segmented {
    display: inline-flex;
    gap: 2px;
    flex-shrink: 0;
    padding: 3px;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
}

.sort-segment {
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 9px;
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.15s ease;
}

.sort-segment:hover {
    color: var(--text-color);
}

.sort-segment.active {
    background: var(--primary-color);
    color: #fff;
    box-shadow: 0 2px 8px -2px color-mix(in srgb, var(--primary-color) 60%, transparent);
}

.sort-segment:active {
    transform: scale(0.96);
}

.search-input-wrapper {
    position: relative;
    flex: 1;
}

.search-input {
    width: 100%;
    padding: 10px 40px 10px 42px !important;
    border: 1px solid var(--border-color) !important;
    border-radius: 10px;
    background-color: var(--background-color) !important;
    color: var(--text-color);
    font-size: 0.92rem;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.search-input:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary-color) 25%, transparent);
}

.search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
}

.clear-search {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: all 0.2s;
}

.clear-search:hover {
    background-color: var(--hover-bg);
    color: var(--text-color);
}

.filter-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 12px 20px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
    background-color: var(--card-bg);
    color: var(--text-color);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
}

.filter-toggle:hover {
    background-color: var(--hover-bg);
    border-color: var(--primary-color);
}

/* Horizontal category chip scroller — reparented into .explore-sticky */
.category-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding: 16px 32px 0;
    margin-bottom: 0;
}
.category-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex: 0 0 auto;
    scroll-snap-align: start;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--border-color);
    background: var(--card-bg);
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
}

.category-chip:hover {
    color: var(--text-color);
    border-color: var(--primary-color);
}

.category-chip:active {
    transform: scale(0.96);
}

.category-chip.active {
    background: var(--primary-color);
    border-color: var(--primary-color);
    color: #fff;
    box-shadow: 0 2px 10px -2px color-mix(in srgb, var(--primary-color) 55%, transparent);
}

.chip-count {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--text-color) 8%, transparent);
    color: var(--text-muted);
}

.category-chip.active .chip-count {
    background: rgba(255, 255, 255, 0.22);
    color: #fff;
}

/* Body Layout */
.explore-body {
    display: grid;
    gap: 24px;
    align-items: start;
    transition: grid-template-columns 0.3s ease;
}

.explore-body:has(.filters-sidebar) {
    grid-template-columns: 240px 1fr;
}

.explore-body:not(:has(.filters-sidebar)) {
    grid-template-columns: 1fr;
}

/* Filters Sidebar */
.filters-sidebar {
    background-color: transparent;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    padding: 24px 20px;
    align-self: start;
    box-sizing: border-box;
}

.filter-section {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.filter-header h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-color);
    margin: 0;
}

.clear-filters-btn {
    background: none;
    border: none;
    color: var(--primary-color);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 4px;
    transition: all 0.2s;
}

.clear-filters-btn:hover {
    background-color: var(--primary-light);
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.filter-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 2px;
}

.filter-select {
    /* Layout only — AppSelect's own CSS (app-select-trigger) owns the box chrome. */
    width: 100%;
}

/* Category List */
.category-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.category-btn {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    border: none;
    border-radius: var(--border-radius-sm);
    background-color: transparent;
    color: var(--text-color);
    font-size: 0.9rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s;
    width: 200px !important;
}

.category-btn:hover {
    background-color: var(--hover-bg);
}

.category-btn.active {
    background-color: var(--primary-color);
    color: white;
    font-weight: 500;
}

.category-btn .count {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: normal;
}

.category-btn.active .count {
    color: rgba(255, 255, 255, 0.8);
}

/* Tags List */
.tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.tag-btn {
    padding: 4px 12px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background-color: transparent;
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
}

.tag-btn:hover {
    border-color: var(--primary-color);
    color: var(--text-color);
}

.tag-btn.active {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
    color: #fff;
}

/* Main Content */
.explore-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1;
    min-height: 50vh;
}

/* Active Filters */
.active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding: 0 0 16px 0;
    background-color: transparent;
    border: none;
}

.active-filters-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
}

.filter-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background-color: var(--primary-color);
    color: #fff;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 500;
}

.filter-chip button {
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 0.2s;
}

.filter-chip button:hover {
    background-color: rgba(0, 0, 0, 0.2);
}

/* APIs Grid */
.apis-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
    align-items: start;
}

/* API Card */
/* API Card - 2026 Modern Design */
.api-card {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 20px;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
        box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1),
        border-color 0.25s ease;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    /* Staggered entrance; --i set inline per card */
    animation: card-enter 0.4s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: calc(var(--i, 0) * 40ms);
}

.api-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -10px color-mix(in srgb, var(--primary-color) 18%, rgba(0, 0, 0, 0.22));
    border-color: color-mix(in srgb, var(--primary-color) 40%, var(--border-color));
}

.api-card:hover .api-icon {
    transform: scale(1.06);
}

.api-icon {
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes card-enter {
    from {
        opacity: 0;
        transform: translateY(14px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Card Top: Identity */
.api-card-top {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-bottom: 0;
}

.api-identity {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
}

.api-icon {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: 10px;
    overflow: hidden;
    background-color: var(--background-color);
    border: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
}

.api-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.api-icon-placeholder {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-color);
    font-family: 'Inter', sans-serif;
}

.api-title-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.api-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-color);
    margin: 0;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.api-provider {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
}

/* Meta row: badges + category pill inline under title block */
.api-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 12px;
}

.badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
    background-color: transparent;
}

.badge-featured {
    color: #eab308;
    border: 1px solid color-mix(in srgb, #eab308 40%, var(--border-color));
}

.badge-trending {
    color: var(--primary-color);
    border: 1px solid color-mix(in srgb, var(--primary-color) 40%, var(--border-color));
}

.api-category-pill {
    background: var(--hover-bg);
    color: var(--text-secondary);
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.4;
}

/* Description */
.api-card-body {
    margin-bottom: 12px;
    min-height: 4.05em;
}

.api-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* Footer & Stats */
.api-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid var(--border-color);
    margin-top: auto;
    gap: 8px;
}

.stats-row {
    display: flex;
    align-items: center;
    gap: 8px;
}

.stat-item {
    display: flex;
    align-items: baseline;
    gap: 5px;
    font-size: 0.85rem;
    color: var(--text-color);
    font-weight: 600;
}

/* Scope-fix: a global .stat-value (APINetworkExplore.css) blows this up to 1.75rem.
   Force the compact inline rating here. */
.api-card .stat-value {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-color);
    line-height: 1;
}

.star-icon {
    color: #eab308;
    /* Star yellow */
    transform: translateY(1px);
}

.stat-sub {
    font-weight: 400;
    color: var(--text-muted);
    margin-left: 2px;
    font-size: 0.8rem;
}

.separator-dot {
    font-size: 0.6rem;
    color: var(--border-color);
}

.tags-row {
    display: flex;
    gap: 8px;
}

.tech-badge {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    background-color: transparent;
    font-family: 'Roboto Mono', monospace;
    opacity: 0.95;
}

/* Action row — always visible */
.api-card-actions {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border-color);
}

.card-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 9px;
    border: 1px solid var(--border-color);
    background: var(--background-color);
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease, background-color 0.18s ease;
}

.card-action:hover {
    border-color: var(--primary-color);
    color: var(--primary-color);
    background: var(--hover-bg);
}

.card-action-primary {
    background: var(--primary-color);
    border-color: var(--primary-color);
    color: #fff;
    flex: 1;
    justify-content: center;
}

.card-action-primary:hover {
    background: var(--primary-hover);
    color: #fff;
}

.card-action-icon {
    padding: 8px 10px;
    margin-left: auto;
}

.card-action-icon.saved {
    color: var(--primary-color);
    border-color: var(--primary-color);
}

/* Skeleton shimmer (loading) */
.skeleton-card {
    cursor: default;
    pointer-events: none;
}

.sk {
    background: var(--hover-bg, var(--card-bg));
    border-radius: 8px;
    position: relative;
    overflow: hidden;
}

.sk::after {
    content: '';
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--text-color) 8%, transparent), transparent);
    animation: sk-shimmer 1.3s infinite;
}

.sk-top {
    display: flex;
    gap: 14px;
    background: transparent;
    margin-bottom: 20px;
}

.sk-avatar {
    width: 44px;
    height: 44px;
    min-width: 44px;
    border-radius: 12px;
}

.sk-lines {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    background: transparent;
    justify-content: center;
}

.sk-line {
    height: 12px;
}

.sk-line-lg {
    width: 55%;
}

.sk-line-sm {
    width: 35%;
    height: 10px;
}

.sk-body {
    height: 12px;
    margin-bottom: 10px;
}

.sk-body-short {
    width: 70%;
    margin-bottom: 24px;
}

.sk-footer {
    display: flex;
    gap: 10px;
    background: transparent;
    margin-top: auto;
}

.sk-pill {
    width: 64px;
    height: 24px;
    border-radius: 6px;
}

@keyframes sk-shimmer {
    100% {
        transform: translateX(100%);
    }
}

/* Loading & Empty States */
.loading-state,
.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    text-align: center;
    background-color: transparent;
    border: none;
    width: 100%;
}

.spinner {
    width: 48px;
    height: 48px;
    border: 4px solid var(--border-color);
    border-top-color: var(--primary-color);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.loading-state p,
.empty-state p {
    margin-top: 16px;
    color: var(--text-secondary);
}

.empty-state h3 {
    margin: 16px 0 8px;
    color: var(--text-color);
}

.empty-state .btn-primary {
    margin-top: 16px;
}

/* Load More */
.load-more-section {
    display: flex;
    justify-content: center;
    padding: 20px 0;
}

/* Buttons */
.btn-primary,
.btn-secondary {
    padding: 10px 24px;
    border: none;
    border-radius: var(--border-radius);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-primary {
    background-color: var(--primary-color);
    color: white;
}

.btn-primary:hover {
    background-color: var(--primary-hover);
}

.btn-secondary {
    background-color: var(--secondary-color);
    color: white;
}

.btn-secondary:hover {
    background-color: var(--secondary-hover);
}

.btn-secondary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

/* Responsive Design */
@media (max-width: 1200px) {
    .apis-grid {
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }
}

@media (max-width: 992px) {
    .explore-body {
        grid-template-columns: 1fr;
    }

    .filters-sidebar {
        position: relative;
        top: 0;
    }
}

/* Accessibility: honor reduced-motion */
@media (prefers-reduced-motion: reduce) {

    .api-card,
    .sk::after,
    .api-card::before,
    .api-icon {
        animation: none !important;
        transition: none !important;
    }

    .api-card {
        opacity: 1 !important;
        transform: none !important;
    }
}

@media (max-width: 768px) {
    .explore-page {
        padding: 16px;
    }

    .explore-toolbar {
        margin: 0 -16px 20px;
        padding: 12px 16px;
    }

    .sort-segmented {
        width: 100%;
        justify-content: space-between;
    }

    .header-content h1 {
        font-size: 1.5rem;
    }

    .search-section {
        flex-direction: column;
    }

    .search-input-wrapper {
        max-width: none;
    }

    .apis-grid {
        grid-template-columns: 1fr;
    }
}