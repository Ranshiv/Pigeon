/* Parameter Node Styles */
.parameter-node {
    position: relative;
    background: #fff9e6; /* Light cream background */
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    width: 220px;
    height: 40px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    user-select: none;
    border: none;
    margin: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    overflow: hidden;
}

.parameter-node:hover {
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
    transform: translateY(-1px);
}

.parameter-node.selected {
    box-shadow: 0 0 0 2px rgba(245, 176, 66, 0.4);
}

.parameter-node.dragging {
    opacity: 0.8;
    transform: rotate(1deg);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
}

/* Connection Points */
.connection-point {
    position: absolute;
    width: 8px;
    height: 8px;
    background-color: #fff;
    border-radius: 50%;
    z-index: 2;
    top: 50%;
    transform: translateY(-50%);
}

.connection-left {
    left: -4px;
}

.connection-right {
    right: -4px;
}

/* Node Content */
.node-content {
    display: flex;
    flex-direction: column;
}

/* Node Header */
.node-header {
    display: flex;
    align-items: center;
    padding: 12px;
    background-color: #252525;
    border-bottom: 1px solid #333;
    justify-content: space-between;
}

.header-icon {
    color: #aaa;
    margin-right: 8px;
}

.header-title {
    flex: 1;
    font-size: 12px;
    font-weight: 500;
    color: #aaa;
}

.header-menu {
    color: #777;
    cursor: pointer;
}

.header-menu:hover {
    color: #fff;
}

/* Node Body */
.node-body {
    padding: 12px;
}

.node-title {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 4px;
}

.node-description {
    margin: 0;
    font-size: 12px;
    color: #999999;
}

/* Node Footer */
.node-footer {
    padding: 10px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #333;
}

.parameter-tag {
    display: flex;
    align-items: center;
    background-color: rgba(245, 176, 66, 0.15);
    color: #f5b042;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 4px;
}

.parameter-tag svg {
    margin-right: 4px;
    width: 12px;
    height: 12px;
}

.parameter-tag span {
    margin-left: 4px;
}

.status-badge {
    background: linear-gradient(90deg, #ff6b4a 0%, #ff8e53 100%);
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Selection Outline */
.selection-outline {
    position: absolute;
    top: -3px;
    left: -3px;
    right: -3px;
    bottom: -3px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 10px;
    pointer-events: none;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.1);
}
