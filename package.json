{
  "name": "pigeon",
  "version": "1.0.0",
  "main": "index.js",
  "bin": {
    "pigeon": "./cli/pigeon-cli.js"
  },
  "scripts": {
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "cli": "node ./cli/pigeon-cli.js",
    "generate:guide-pdf": "node generate-pdf-guide.js",
    "clean:empty:dry": "node ./scripts/remove-empty-files.js",
    "clean:empty": "node ./scripts/remove-empty-files.js --apply",
    "contract:diff": "node ./cli/pigeon-cli.js diff --base test-api-v1.json --head test-api-v2.json --format html --output diff-report.html"
  },
  "keywords": [
    "api",
    "testing",
    "automation",
    "ci",
    "cd"
  ],
