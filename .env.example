# Pigeon API Monitor - Environment Variables Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control!

# ==============================================
# Database Configuration
# ==============================================
MONGODB_URI=mongodb://localhost:27017/pigeon
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/pigeon

# ==============================================
# Server Configuration
# ==============================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ==============================================
# JWT Authentication
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# ==============================================
# Email Configuration
# ==============================================
# RECOMMENDED FOR PRODUCTION: Brevo (Sendinblue) Transactional Email
# Configure ONCE on the server (deployment secret). Users never edit env.
# Get your API key from Brevo: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Optional sender override (otherwise EMAIL_FROM / EMAIL_USER is used)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Pigeon

# PREFERRED METHOD: OAuth2 (Automatic via Google Login)
# Users automatically send emails from their logged-in Google account
# No manual email configuration required in production!
# See docs/OAUTH2_EMAIL_SETUP.md for setup details

# FALLBACK METHOD: SMTP (Optional)
# Used for system emails or if OAuth2 not available
# For Gmail: Generate app-specific password at https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password
EMAIL_FROM=Pigeon Monitor <your-email@gmail.com>

# Optional: Explicit SMTP settings (auto-configured for Gmail)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# For Outlook/Office 365:
# EMAIL_SERVICE=outlook
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_USER=your-email@outlook.com
# EMAIL_PASSWORD=your-password

# For SendGrid:
# EMAIL_SERVICE=sendgrid
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_USER=apikey
# EMAIL_PASSWORD=your-sendgrid-api-key

# ==============================================
# Monitoring Configuration
# ==============================================
MONITOR_CHECK_INTERVAL=60000
# Check interval in milliseconds (default: 60000 = 1 minute)

HEALTH_CHECK_RETENTION_DAYS=30
# How many days to keep health check history

# ==============================================
# Alert Configuration
# ==============================================
MAX_ALERTS_PER_HOUR=10
# Maximum alerts per integration per hour

ALERT_COOLDOWN_MINUTES=5
# Minutes between duplicate alerts

# ==============================================
# Integration Services (Optional)
# ==============================================

# Slack
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SLACK_CHANNEL=#monitoring

# PagerDuty
# PAGERDUTY_INTEGRATION_KEY=your-pagerduty-integration-key

# Datadog
# DATADOG_API_KEY=your-datadog-api-key
# DATADOG_SITE=datadoghq.com

# ==============================================
# Redis (Optional - for shared sessions across >1 node)
# ==============================================
# Local: REDIS_URL=redis://localhost:6379
# Upstash: REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379
# REDIS_PASSWORD=your-redis-password

# ==============================================
# AWS S3 (Optional - for file storage)
# ==============================================
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=pigeon-storage

# ==============================================
# OAuth Providers (Optional)
# ==============================================

# Google OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# ==============================================
# Rate Limiting
# ==============================================
RATE_LIMIT_WINDOW_MS=900000
# Rate limit window in milliseconds (default: 15 minutes)

RATE_LIMIT_MAX_REQUESTS=100
# Maximum requests per window

# ==============================================
# CORS Configuration
# ==============================================
CORS_ORIGIN=http://localhost:3000
# Comma-separated list: http://localhost:3000,https://yourdomain.com

# ==============================================
# Logging
# ==============================================
LOG_LEVEL=info
# Options: error, warn, info, debug

LOG_TO_FILE=false
# Set to true to enable file logging

# ==============================================
# Feature Flags
# ==============================================
ENABLE_ANALYTICS=true
ENABLE_REAL_TIME_ALERTS=true
ENABLE_MAINTENANCE_MODE=false

# ==============================================
# Security
# ==============================================
SESSION_SECRET=your-session-secret-change-this-in-production
COOKIE_SECURE=false
# Set to true in production with HTTPS

# ==============================================
# Development/Testing
# ==============================================
MOCK_EXTERNAL_SERVICES=false
# Set to true to mock external API calls in tests

TEST_MODE=false
# Set to true to enable test mode features

# ==============================================
# Performance
# ==============================================
MAX_CONCURRENT_CHECKS=50
# Maximum concurrent monitor checks

CACHE_TTL_SECONDS=300
# Cache time-to-live in seconds

# ==============================================
# Notification Preferences
# ==============================================
SUPPRESS_STARTUP_WARNINGS=false
# Set to true to suppress non-critical warnings on startup

ENABLE_EMOJI_LOGS=true
# Set to false to disable emoji in console logs

# ==============================================
# API Documentation
# ==============================================
ENABLE_API_DOCS=true
# Enables Swagger/OpenAPI documentation at /api-docs

API_DOCS_PATH=/api-docs

# ==============================================
# Backup & Recovery
# ==============================================
ENABLE_AUTO_BACKUP=false
# Enable automatic database backups

BACKUP_SCHEDULE="0 2 * * *"
# Cron schedule for backups (default: 2 AM daily)

BACKUP_RETENTION_DAYS=7
# How many days to keep backups

# ==============================================
# Notes:
# ==============================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual values
# 3. Never commit .env to version control
# 4. Add .env to .gitignore
# 5. For Gmail, see docs/EMAIL_SETUP_GUIDE.md for app password setup
# 6. Restart server after changing environment variables
