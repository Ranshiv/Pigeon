{
  "info": {
    "_postman_id": "browser-smoke-collection",
    "name": "QA Browser Import Smoke",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://example.com"
    }
  ],
  "item": [
    {
      "name": "Smoke folder",
      "item": [
        {
          "name": "Get example",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health?source=postman",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          }
        }
      ]
    }
  ]
}
