{
    "openapi": "3.0.0",
    "info": {
        "title": "Test API - Version 3 (Major Breaking Changes)",
        "version": "3.0.0",
        "description": "API with major breaking changes for diff testing"
    },
    "servers": [
        {
            "url": "https://api.example.com/v3",
            "description": "Version 3 API Server"
        }
    ],
    "paths": {
        "/users": {
            "get": {
                "summary": "Get users",
                "description": "Retrieve users - completely changed response format",
                "parameters": [
                    {
                        "name": "token",
                        "in": "header",
                        "required": true,
                        "description": "NEW REQUIRED: Authentication token",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success - completely new format",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "users": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "uuid": {
                                                        "type": "string",
                                                        "format": "uuid",
                                                        "description": "User UUID (changed from id)"
                                                    },
                                                    "fullName": {
                                                        "type": "string",
                                                        "description": "Full name (changed from name)"
                                                    },
                                                    "emailAddress": {
                                                        "type": "string",
                                                        "format": "email",
                                                        "description": "Email (changed from email)"
                                                    }
                                                },
                                                "required": [
                                                    "uuid",
                                                    "fullName",
                                                    "emailAddress"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "users"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/organizations": {
            "get": {
                "summary": "Get organizations",
                "description": "Get all organizations",
                "responses": {
                    "200": {
                        "description": "List of organizations",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "id": {
                                                "type": "string",
                                                "format": "uuid"
                                            },
                                            "name": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "type": "object",
                "properties": {
                    "uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "fullName": {
                        "type": "string"
                    },
                    "emailAddress": {
                        "type": "string",
                        "format": "email"
                    }
                },
                "required": [
                    "uuid",
                    "fullName",
                    "emailAddress"
                ]
            }
        }
    }
}